<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
	    var noteButton = document.getElementById('save-admin-note');
	    if (noteButton) {
	      noteButton.addEventListener('click', function() {
	        var noteField = document.getElementById('order-admin-note');
	        var status = document.getElementById('admin-note-status');
	        var url = noteButton.getAttribute('data-url') || '';
	        if (!url || !noteField) return;
	        noteButton.disabled = true;
	        if (status) {
	          status.className = 'order-admin-note-status';
	          status.textContent = 'Saving...';
	        }
	        var body = 'admin_note=' + encodeURIComponent(noteField.value || '');
	        fetch(url, {
	          method: 'POST',
	          headers: {'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'},
	          credentials: 'same-origin',
	          body: body
	        }).then(function(response) {
	          return response.json();
	        }).then(function(payload) {
	          if (payload && payload.success) {
	            if (status) {
	              status.className = 'order-admin-note-status is-success';
	              status.textContent = payload.success;
	            }
	          } else {
	            throw new Error((payload && payload.error) || 'Could not save note.');
	          }
	        }).catch(function(error) {
	          if (status) {
	            status.className = 'order-admin-note-status is-error';
	            status.textContent = error.message || 'Could not save note.';
	          }
	        }).then(function() {
	          noteButton.disabled = false;
	        });
	      });
	    }
	    var importButton = document.getElementById('submit-import-reservation');
	    if (importButton) {
	      importButton.addEventListener('click', function() {
	        var input = document.getElementById('import-yolcu-order-id');
	        var status = document.getElementById('import-reservation-status');
	        var url = importButton.getAttribute('data-url') || '';
	        var providerOrderId = input ? (input.value || '').trim() : '';
	        if (!url || !providerOrderId) {
	          if (status) {
	            status.className = 'order-import-status is-error';
	            status.textContent = 'Yolcu360 order ID is required.';
	          }
	          return;
	        }
	        importButton.disabled = true;
	        if (status) {
	          status.className = 'order-import-status';
	          status.textContent = 'Importing reservation...';
	        }
	        fetch(url, {
	          method: 'POST',
	          headers: {'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'},
	          credentials: 'same-origin',
	          body: 'yolcu_order_id=' + encodeURIComponent(providerOrderId)
	        }).then(function(response) {
	          return response.json();
	        }).then(function(payload) {
	          if (payload && payload.success) {
	            if (status) {
	              status.className = 'order-import-status is-success';
	              status.textContent = payload.success + ' Refreshing...';
	            }
	            window.setTimeout(function() { window.location.reload(); }, 900);
	          } else {
	            throw new Error((payload && payload.error) || 'Reservation import failed.');
	          }
	        }).catch(function(error) {
	          if (status) {
	            status.className = 'order-import-status is-error';
	            status.textContent = error.message || 'Reservation import failed.';
	          }
	          importButton.disabled = false;
	        });
	      });
	    }
	    var auditFilterButtons = document.querySelectorAll('[data-api-audit-filter]');
	    var auditItems = document.querySelectorAll('.api-audit-item');
	    Array.prototype.forEach.call(auditFilterButtons, function(filterButton) {
	      filterButton.addEventListener('click', function() {
	        var filter = filterButton.getAttribute('data-api-audit-filter') || 'all';
	        Array.prototype.forEach.call(auditFilterButtons, function(button) {
	          button.classList.toggle('active', button === filterButton);
	        });
	        Array.prototype.forEach.call(auditItems, function(item) {
	          var category = item.getAttribute('data-api-audit-category') || '';
	          var status = item.getAttribute('data-api-audit-status') || '';
	          var visible = filter === 'all' || category === filter || (filter === 'failed' && status === 'failed');
	          item.classList.toggle('is-hidden', !visible);
	        });
	      });
	    });
	    Array.prototype.forEach.call(document.querySelectorAll('.api-audit-copy'), function(copyButton) {
	      copyButton.addEventListener('click', function() {
	        var targetId = copyButton.getAttribute('data-copy-target') || '';
	        var targetNode = document.getElementById(targetId);
	        var text = targetNode ? targetNode.textContent : '';
	        if (!text) return;
	        function markCopied() {
	          var icon = copyButton.querySelector('i');
	          copyButton.classList.add('copied');
	          if (icon) icon.className = 'fa fa-check';
	          window.setTimeout(function() {
	            copyButton.classList.remove('copied');
	            if (icon) icon.className = 'fa fa-clipboard';
	          }, 1400);
	        }
	        if (navigator.clipboard && navigator.clipboard.writeText) {
	          navigator.clipboard.writeText(text).then(markCopied);
	        } else {
	          var textarea = document.createElement('textarea');
	          textarea.value = text;
	          textarea.style.position = 'fixed';
	          textarea.style.left = '-9999px';
	          document.body.appendChild(textarea);
	          textarea.select();
	          try {
	            if (document.execCommand('copy')) markCopied();
	          } catch (e) {}
	          document.body.removeChild(textarea);
	        }
	      });
	    });
  });
})();
</script>
