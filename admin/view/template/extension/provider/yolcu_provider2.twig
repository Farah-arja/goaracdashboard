{{ header }}{{ column_left }}

<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-yolcu-provider2" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

{% if success %}
<div class="alert alert-success">
  <i class="fa fa-check-circle"></i> {{ success }}
  <button type="button" class="close" data-dismiss="alert">&times;</button>
</div>
{% endif %}
<div class="panel panel-default">
  <div class="panel-heading">
    <h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_edit }}</h3>
  </div>

  <div class="panel-body">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-yolcu-provider2" class="form-horizontal">

      <input type="hidden" name="module_yolcu_provider2_api_logging_status" value="{{ module_yolcu_provider2_api_logging_status }}" />

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_status }}</label>
        <div class="col-sm-10">
          <select name="module_yolcu_provider2_status" class="form-control">
            {% if module_yolcu_provider2_status %}
            <option value="1" selected="selected">{{ text_enabled }}</option>
            <option value="0">{{ text_disabled }}</option>
            {% else %}
            <option value="1">{{ text_enabled }}</option>
            <option value="0" selected="selected">{{ text_disabled }}</option>
            {% endif %}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_api_url }}">{{ entry_api_url }}</span></label>
        <div class="col-sm-10">
          <input type="text" name="module_yolcu_provider2_api_url" value="{{ module_yolcu_provider2_api_url }}" class="form-control" />
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_api_key }}</label>
        <div class="col-sm-10">
          <input type="text" name="module_yolcu_provider2_api_key" value="{{ module_yolcu_provider2_api_key }}" class="form-control" />
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_api_secret }}</label>
        <div class="col-sm-10">
          <input type="password" name="module_yolcu_provider2_api_secret" value="{{ module_yolcu_provider2_api_secret }}" class="form-control" />
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_default_currency }}</label>
        <div class="col-sm-10">
          <select name="module_yolcu_provider2_default_currency" class="form-control">
            {% for currency in currencies %}
              {% if currency.code == module_yolcu_provider2_default_currency %}
                <option value="{{ currency.code }}" selected="selected">{{ currency.title }}</option>
              {% else %}
                <option value="{{ currency.code }}">{{ currency.title }}</option>
              {% endif %}
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_default_language }}</label>
        <div class="col-sm-10">
          <select name="module_yolcu_provider2_default_language" class="form-control">
            {% for language in languages %}
              {% if language.code == module_yolcu_provider2_default_language %}
                <option value="{{ language.code }}" selected="selected">{{ language.name }}</option>
              {% else %}
                <option value="{{ language.code }}">{{ language.name }}</option>
              {% endif %}
            {% endfor %}
          </select>
        </div>
      </div>

      <fieldset>
        <legend>{{ text_yolcu_search_rules }}</legend>

        <div class="alert alert-info">{{ help_yolcu_search_rules }}</div>

        <div class="form-group">
          <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_search_commission_status }}">{{ entry_search_commission_status }}</span></label>
          <div class="col-sm-10">
            <select name="module_yolcu_provider2_search_commission_status" class="form-control">
              <option value="1" {{ module_yolcu_provider2_search_commission_status ? 'selected="selected"' : '' }}>{{ text_enabled }}</option>
              <option value="0" {{ not module_yolcu_provider2_search_commission_status ? 'selected="selected"' : '' }}>{{ text_disabled }}</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_commission_type }}">{{ entry_commission_type }}</span></label>
          <div class="col-sm-10">
            <select name="module_yolcu_provider2_commission_type" class="form-control">
              <option value="percentage" {{ module_yolcu_provider2_commission_type == 'percentage' ? 'selected="selected"' : '' }}>{{ text_percentage }}</option>
              <option value="fixed" {{ module_yolcu_provider2_commission_type == 'fixed' ? 'selected="selected"' : '' }}>{{ text_fixed }}</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_commission_percentage }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_commission_percentage" value="{{ module_yolcu_provider2_commission_percentage }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_commission_fixed_amount }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_commission_fixed_amount" value="{{ module_yolcu_provider2_commission_fixed_amount }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_campaign_code_status }}">{{ entry_campaign_code_status }}</span></label>
          <div class="col-sm-10">
            <select name="module_yolcu_provider2_campaign_code_status" class="form-control">
              <option value="1" {{ module_yolcu_provider2_campaign_code_status ? 'selected="selected"' : '' }}>{{ text_enabled }}</option>
              <option value="0" {{ not module_yolcu_provider2_campaign_code_status ? 'selected="selected"' : '' }}>{{ text_disabled }}</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_campaign_code }}">{{ entry_campaign_code }}</span></label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_campaign_code" value="{{ module_yolcu_provider2_campaign_code }}" class="form-control" />
          </div>
        </div>
      </fieldset>

      <div class="form-group">
        <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_payment_type }}">{{ entry_payment_type }}</span></label>
        <div class="col-sm-10">
          <select name="module_yolcu_provider2_api_payment_type" class="form-control">
            <option value="limit" {{ module_yolcu_provider2_api_payment_type == 'limit' ? 'selected="selected"' : '' }}>limit</option>
            <option value="creditCard" {{ module_yolcu_provider2_api_payment_type == 'creditCard' ? 'selected="selected"' : '' }}>creditCard</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_full_credit }}</label>
        <div class="col-sm-10">
          <select name="module_yolcu_provider2_api_payment_is_full_credit" class="form-control">
            <option value="1" {{ module_yolcu_provider2_api_payment_is_full_credit ? 'selected="selected"' : '' }}>{{ text_enabled }}</option>
            <option value="0" {{ not module_yolcu_provider2_api_payment_is_full_credit ? 'selected="selected"' : '' }}>{{ text_disabled }}</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_limited_credit }}</label>
        <div class="col-sm-10">
          <select name="module_yolcu_provider2_api_payment_is_limited_credit" class="form-control">
            <option value="1" {{ module_yolcu_provider2_api_payment_is_limited_credit ? 'selected="selected"' : '' }}>{{ text_enabled }}</option>
            <option value="0" {{ not module_yolcu_provider2_api_payment_is_limited_credit ? 'selected="selected"' : '' }}>{{ text_disabled }}</option>
          </select>
        </div>
      </div>

      <fieldset>
        <legend>{{ text_site_content }}</legend>

        <div class="alert alert-info">
          {{ help_site_content_json }}
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_site_content_json }}</label>
          <div class="col-sm-10">
            <textarea name="module_yolcu_provider2_site_content_json" rows="12" class="form-control">{{ module_yolcu_provider2_site_content_json }}</textarea>
            <p class="help-block">{{ text_site_content_json_hint }}</p>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Endpoints</legend>

        <div class="alert alert-info">
          Checkout displays eligible installment options from the BKM BIN integration when the customer enters a supported Turkish credit card. Single payment stays available by default.
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_auth_login }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_auth_login" value="{{ module_yolcu_provider2_endpoint_auth_login }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_auth_refresh }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_auth_refresh" value="{{ module_yolcu_provider2_endpoint_auth_refresh }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_locations }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_locations" value="{{ module_yolcu_provider2_endpoint_locations }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_search }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_search" value="{{ module_yolcu_provider2_endpoint_search }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_orders }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_orders" value="{{ module_yolcu_provider2_endpoint_orders }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_payment_process }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_payment_process" value="{{ module_yolcu_provider2_endpoint_payment_process }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_payment_3d_secure_callback }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_payment_3d_secure_callback" value="{{ module_yolcu_provider2_endpoint_payment_3d_secure_callback }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_helper_car_classes }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_helper_car_classes" value="{{ module_yolcu_provider2_endpoint_helper_car_classes }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_helper_fuel_types }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_helper_fuel_types" value="{{ module_yolcu_provider2_endpoint_helper_fuel_types }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_helper_transmission_types }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_helper_transmission_types" value="{{ module_yolcu_provider2_endpoint_helper_transmission_types }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_helper_delivery_types }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_helper_delivery_types" value="{{ module_yolcu_provider2_endpoint_helper_delivery_types }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_helper_extra_products }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_helper_extra_products" value="{{ module_yolcu_provider2_endpoint_helper_extra_products }}" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_endpoint_helper_suppliers }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_yolcu_provider2_endpoint_helper_suppliers" value="{{ module_yolcu_provider2_endpoint_helper_suppliers }}" class="form-control" />
          </div>
        </div>
      </fieldset>

    </form>
  </div>
</div>


  </div>
</div>

{{ footer }}
