RewriteEngine on
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
#Paste into your opencart root folder .htaccess file after "RewriteBase /"


####################################### Shopping Cart Rest API START #################################################
# Sets the HTTP_AUTHORIZATION header removed by apache
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^privacypolicy index.php?route=common/privacypolicy  [L]
RewriteRule ^conditions-of-use index.php?route=common/termsofuse  [L]


# Tokens
RewriteRule ^api/rest/oauth2/token/?([a-zA-Z0-9_]+)$ index.php?route=feed/rest_api/gettoken&grant_type=$1 [L,QSA]
